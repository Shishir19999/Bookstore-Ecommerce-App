PORT=5000
MONGO_URI=mongodb://localhost:27017/bookStore
# Required: long random string used to sign JWTs (server exits at startup if missing)
JWT_SECRET=REPLACE_ME
# Public URL of the frontend (used for Stripe success/cancel redirects)
FRONTEND_URL=http://localhost:5173
# First-run admin: created only if no admin exists and ADMIN_PASSWORD (min 8 chars) is set
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Stripe TEST mode (optional). Leave STRIPE_SECRET_KEY empty to use the labelled MOCK payment path.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
